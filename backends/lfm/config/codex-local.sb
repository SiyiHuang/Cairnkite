(version 1)
(allow default)
(deny network-outbound)
(allow network-outbound (remote ip "localhost:8080"))
(allow network-outbound (remote ip (param "LFM_CODEX_PROVIDER")))
(allow network-outbound (remote unix-socket (path (param "SPECIALISTS_SOCKET"))))
(allow network-outbound (remote unix-socket (path (param "OMNI_SOCKET"))))
(deny file-write*)
(allow file-write* (subpath (param "LFM_STATE")))
(allow file-write* (literal "/dev/null") (regex #"^/dev/ttys[0-9]+$"))
