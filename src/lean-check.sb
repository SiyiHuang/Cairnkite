(version 1)
(deny default)
(allow process-exec (literal (param "LEAN_BINARY")))
(allow file-read*
  (literal "/")
  (subpath (param "LEAN_ROOT"))
  (subpath (param "LEAN_MATHLIB"))
  (subpath (param "PROOF_DIR"))
  (subpath "/System")
  (subpath "/usr/lib")
  (subpath "/usr/share/icu")
  (literal "/dev/null")
  (literal "/dev/urandom"))
(allow file-write* (literal (param "PROOF_OUTPUT")) (literal (param "PROOF_TEMP")))
(allow sysctl-read)
(allow file-read-metadata)
